#!/bin/bash

cd /sources

# Check if libtasn1 is installed
if ! find /usr/lib /usr/local/lib -name "libtasn1*" > /dev/null 2>&1; then
    echo "libtasn1 not found. Installing libtasn1."
    bash libtasn1-4.19.0
    echo "libtasn1 is installed."
fi

tar -xvf wget-1.21.4.tar.gz

cd wget-1.21.4

./configure --prefix=/usr      \
            --sysconfdir=/etc  \
            --with-ssl=openssl &&
make

make install


cd ..

rm -rf wget-1.21.4
